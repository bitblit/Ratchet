{
  "name": "@bitblit/ratchet-epsilon-common",
  "version": "0.0.0-snapshot",
  "description": "Tiny adapter to simplify building API gateway Lambda APIS",
  "sideEffects": false,
  "bin": {
    "epsilon-cli": "./bin/cli.js"
  },
  "type": "module",
  "files": [
    "src/**",
    "lib/**",
    "bin/**"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js"
    }
  },
  "contributors": [
    "Christopher Weiss <bitblit@gmail.com>",
    "Benn Linger <benn@bennlinger.com>",
    "Lucas Myers <veganbeef@protonmail.com>",
    "Bilal Shahid <bshahid@adomni.com>",
    "Zach Herridge"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bitblit/Ratchet"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "prettier": {
    "printWidth": 140,
    "singleQuote": true,
    "arrowParens": "always"
  },
  "config": {},
  "scripts": {
    "run-local-container-server": "pnpm mod:build && node bin/cli.js run-local-container-server",
    "run-build-sample-server": "pnpm mod:build && node bin/cli.js run-sample-local-server",
    "run-sample-server": "node bin/cli.js run-sample-local-server",
    "run-test-error-server": "pnpm mod:build && node bin/cli.js run-test-error-server",
    "run-batch-sample-server": "pnpm mod:build && node bin/cli.js run-sample-local-batch-server",
    "run-background-process-from-command-line-dry-run": "pnpm mod:build && node bin/cli.js run-background-process"
  },
  "keywords": [
    "epsilon",
    "lambda",
    "api gateway"
  ],
  "bugs": {
    "url": "https://github.com/bitblit/Ratchet/issues"
  },
  "homepage": "https://github.com/bitblit/Ratchet#readme",
  "engines": {
    "node": ">=14.18"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test-coverage": "vitest run  --coverage",
    "custom-publish": "pnpm publish --access public --provenance --tag $GITHUB_REF_NAME --no-git-checks",
    "clean": "shx rm -Rf lib",
    "pretty": "prettier src --write",
    "lint": "eslint -c ../../eslint.config.mjs src/**/*.ts",
    "lint-fix": "pnpm pretty && eslint --fix -c ../../eslint.config.mjs src/**/*.ts",
    "generate-docs": "typedoc"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1095.0",
    "@aws-sdk/client-sns": "3.1095.0",
    "@aws-sdk/client-sqs": "3.1095.0",
    "@aws-sdk/client-batch": "3.1095.0",
    "@aws-sdk/types": "3.974.2",
    "@bitblit/ratchet-aws": "workspace:0.0.0-snapshot",
    "@bitblit/ratchet-common": "workspace:0.0.0-snapshot",
    "@bitblit/ratchet-misc": "workspace:0.0.0-snapshot",
    "@bitblit/ratchet-node-only": "workspace:0.0.0-snapshot",
    "@bitblit/ratchet-aws-node-only": "workspace:0.0.0-snapshot",
    "@smithy/abort-controller": "4.3.3",
    "@smithy/smithy-client": "4.14.14",
    "@smithy/util-waiter": "4.4.4",
    "clear": "0.1.0",
    "commander": "14.0.3",
    "cross-fetch": "4.1.0",
    "js-yaml": "4.3.0",
    "jsonwebtoken": "9.0.3",
    "jwks-rsa": "3.2.2",
    "luxon": "3.7.2",
    "route-parser": "0.0.5",
    "rxjs": "7.8.2",
    "swagger-model-validator": "3.0.21"
  },
  "peerDependencies": {
    "@apollo/server": "^5.5.1",
    "@bitblit/ratchet-aws": "workspace:0.0.0-snapshot",
    "@bitblit/ratchet-common": "workspace:0.0.0-snapshot",
    "@bitblit/ratchet-misc": "workspace:0.0.0-snapshot",
    "@bitblit/ratchet-node-only": "workspace:0.0.0-snapshot",
    "@bitblit/ratchet-aws-node-only": "workspace:0.0.0-snapshot",
    "@graphql-tools/schema": "^10.0.38",
    "@graphql-tools/utils": "^11.2.2",
    "graphql": "^17.0.2"
  },
  "peerDependenciesMeta": {
    "@apollo/server": {
      "optional": true
    },
    "@graphql-tools/schema": {
      "optional": true
    },
    "@graphql-tools/utils": {
      "optional": true
    },
    "graphql": {
      "optional": true
    }
  },
  "devDependencies": {
    "@apollo/server": "5.5.1",
    "@graphql-tools/schema": "10.0.38",
    "@graphql-tools/utils": "11.2.2",
    "@types/aws-lambda": "8.10.162",
    "aws-sdk-client-mock": "4.1.0",
    "graphql": "17.0.2",
    "graphql-tag": "2.12.7"
  }
}
