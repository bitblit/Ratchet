{
  "name": "@bitblit/ngx-acute-common",
  "version": "0.0.0-snapshot",
  "description": "Library for using angular",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "src/**",
    "lib/**",
    "bin/**"
  ],
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./lib/index.d.ts",
      "esm2022": "./lib/index.js",
      "esm": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "contributors": [
    "Christopher Weiss <bitblit@gmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitblit/Ratchet.git"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "prettier": {
    "printWidth": 140,
    "singleQuote": true,
    "arrowParens": "always"
  },
  "config": {},
  "license": "Apache-2.0",
  "scripts": {
    "build": "npx ngc",
    "test": "vitest run",
    "test-coverage": "vitest run  --coverage",
    "custom-publish": "pnpm publish --access public --provenance --tag $GITHUB_REF_NAME --no-git-checks",
    "clean": "shx rm -Rf lib"
  },
  "dependencies": {
    "@angular/animations": "22.0.8",
    "@angular/cdk": "22.0.6",
    "@angular/common": "22.0.8",
    "@angular/compiler": "22.0.8",
    "@angular/core": "22.0.8",
    "@angular/forms": "22.0.8",
    "@angular/platform-browser": "22.0.8",
    "@angular/platform-browser-dynamic": "22.0.8",
    "@angular/router": "22.0.8",
    "@bitblit/ratchet-common": "workspace:0.0.0-snapshot",
    "@bitblit/ratchet-graphql": "workspace:0.0.0-snapshot",
    "primeflex": "4.0.0",
    "primeicons": "8.0.0",
    "primeng": "22.0.0",
    "rxjs": "7.8.2",
    "zone.js": "0.16.2"
  },
  "peerDependencies": {
    "@angular/animations": "^22.0.8",
    "@angular/cdk": "^22.0.8",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/platform-browser": "^22.0.8",
    "@angular/platform-browser-dynamic": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@bitblit/ratchet-common": "workspace:0.0.0-snapshot",
    "@bitblit/ratchet-graphql": "workspace:0.0.0-snapshot",
    "primeflex": "4.0.0",
    "primeicons": "8.0.0",
    "primeng": "22.0.0",
    "rxjs": "7.8.2",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular/compiler-cli": "22.0.8",
    "@bitblit/ratchet-node-only": "workspace:0.0.0-snapshot",
    "tslib": "2.8.1"
  }
}
